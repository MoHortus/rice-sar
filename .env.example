# Copy to .env and fill in. Never commit .env.
# Copernicus Data Space Ecosystem (CDSE) Sentinel Hub OAuth client
# (create one at https://shapps.dataspace.copernicus.eu/dashboard/ -> User settings -> OAuth clients)
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Alternative: the name of a profile saved with sentinelhub-py (`sentinelhub.config --profile <name> ...`)
SH_PROFILE=
